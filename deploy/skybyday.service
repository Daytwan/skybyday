[Unit]
Description=SkybyDay public flight explorer demo
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=skybyday
Group=skybyday
WorkingDirectory=/opt/skybyday/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=SKYTRACE_PROVIDER=adsbfi
Environment=SKYTRACE_COVERAGE_PRESET=den
Environment=SKYTRACE_AIRLABS_MODE=off
Environment=SKYTRACE_HISTORY_ENABLED=false
Environment='SKYTRACE_WS_ALLOWED_ORIGINS=["https://fly.donutmath.com"]'
ExecStart=/opt/skybyday/current/backend/.venv/bin/uvicorn skytrace.demo:create_app --factory --host 127.0.0.1 --port 8091 --workers 1 --ws websockets-sansio --ws-max-size 1024 --timeout-graceful-shutdown 10 --no-access-log
Restart=on-failure
RestartSec=35
TimeoutStopSec=20
MemoryMax=384M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
