# Optional. Copy to .env at the repository root and run backend commands there.
# FastAPI starts one shared live poller. Set synthetic explicitly for offline use.
# The hosted personal demo uses adsbfi; see docs/demo-provider.md for its terms.
# Provider choices: adsblol, adsbfi, synthetic. No automatic source fallback.
# --provider on the one-shot CLI overrides this setting.
SKYTRACE_PROVIDER=adsblol
SKYTRACE_AREA_LATITUDE_DEG=39.8561
SKYTRACE_AREA_LONGITUDE_DEG=-104.6737
SKYTRACE_AREA_RADIUS_NM=60
SKYTRACE_POLL_INTERVAL_SECONDS=30
SKYTRACE_MAX_AIRCRAFT=2000
# Position age: stale must be less than expiry.
SKYTRACE_STALE_AFTER_SECONDS=90
SKYTRACE_EXPIRE_AFTER_SECONDS=300
# Reject entire responses whose provider snapshot exceeds this age.
SKYTRACE_MAX_SNAPSHOT_AGE_SECONDS=90
# WebSocket bounds. Origins are an exact JSON list, not a wildcard or CORS rule.
SKYTRACE_WS_MAX_CLIENTS=32
SKYTRACE_WS_SEND_TIMEOUT_SECONDS=5
SKYTRACE_WS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:4173","http://127.0.0.1:8000","http://localhost:5173","http://localhost:4173","http://localhost:8000"]

# Optional history: `uv sync --project backend --extra history --locked`.
# Migrate: `uv run --project backend --extra history --locked skytrace-history migrate`.
# Keep --extra history on uv run commands when enabled. Startup never changes the schema.
SKYTRACE_HISTORY_ENABLED=false
# SKYTRACE_HISTORY_DATABASE_URL=postgresql://skytrace:change-me@127.0.0.1:5432/skytrace
SKYTRACE_HISTORY_SCHEMA=skytrace_history
SKYTRACE_HISTORY_RETENTION_DAYS=7

# Six observed hubs across continents (not full worldwide coverage):
# SKYTRACE_COVERAGE_PRESET=world_hubs_v1
# SKYTRACE_STALE_AFTER_SECONDS=420
# SKYTRACE_EXPIRE_AFTER_SECONDS=900
# One shared 30-second request slot; each hub sampled about every 180 seconds.

# Disabled AirLabs foundation only; selected is unavailable until later acceptance.
# .env.airlabs is never loaded. Inject a key only after separate activation approval.
SKYTRACE_AIRLABS_MODE=off
SKYTRACE_AIRLABS_API_KEY=
SKYTRACE_AIRLABS_LEDGER_PATH=
